# ==============================================================================
# ROOTWHISPER FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# This template defines client-side configuration variables for Vite and the
# Google Antigravity biophysical AI engine.
#
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO THIS REPOSITORY.
# All VITE_* variables are exposed to the client-side browser bundle.
# ==============================================================================

# Antigravity Backend REST / WebSocket Base URL
# Point this to your deployed Antigravity service or local API proxy
VITE_ANTIGRAVITY_API_URL="https://antigravity.rootwhisper.internal:8443/api/v1"

# Telemetry Source Mode
# Set to 'false' to route all calls to the live Antigravity backend.
# Set to 'true' to use the calibrated local sample telemetry repository.
VITE_USE_SAMPLE_DATA="true"

# ESP32 Wi-Fi Mesh Gateway Identifier
VITE_ESP32_MESH_ID="ESP32_MESH_CHAMBER_A4"

# Antigravity Biophysical AI Model Version
VITE_AI_MODEL_VERSION="Antigravity-PhysioFingerprint-v2.4"

# Sensor Acquisition Interval (milliseconds)
# Standard scientific screening rate (default: 5 minutes = 300000 ms)
VITE_SAMPLING_INTERVAL_MS="300000"

# Live UI Pulse Simulator Cadence (milliseconds)
# Interval for gentle transpirational jitter in the interface
VITE_UI_REFRESH_MS="8000"

# Application Deployment URL
# Injected at runtime by hosting environments (Cloud Run, Vercel, Netlify)
APP_URL="http://localhost:3000"
