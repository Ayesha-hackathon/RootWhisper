# RootWhisper Backend Configuration Template
# Database Configuration (SQLite default; PostgreSQL/Neon for Cloud)
DATABASE_URL=sqlite:///./data/rootwhisper.db

# Authentication & Security
ROOTWHISPER_JWT_SECRET=your_jwt_secret_key_here
ENVIRONMENT=development

# Frontend Base URL (for password reset links)
FRONTEND_BASE_URL=http://localhost:3000

# Outgoing Email via Google Gmail API (HTTPS OAuth 2.0 - Recommended for Cloud/Render Free)
EMAIL_PROVIDER=GMAIL_API
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token
GMAIL_SENDER_EMAIL=your_email@gmail.com

# Outgoing Email via SMTP (STARTTLS - Localhost/Dev Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com


